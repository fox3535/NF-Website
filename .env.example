# Nostalgia Fest platform environment.
#
# Copy to .env.local and fill in from the Supabase dashboard. .env.local is
# gitignored; this template is committed and must never contain a real value.
#
# NOTHING on the public marketing site reads these. The homepage, both event
# pages and the three legal pages render with every variable below unset, and
# the production build passes without them. See docs/platform-architecture.md.

# --- Supabase: browser-safe -------------------------------------------------
# Both are safe to expose. The NEXT_PUBLIC_ prefix means Next.js inlines them
# into the client bundle, which is intended. The publishable key grants nothing
# on its own: every table is protected by Row Level Security.
#
# Supabase dashboard: Project Settings -> API -> Project URL / publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: server only --------------------------------------------------
# DANGER: the secret key bypasses Row Level Security completely. It has no
# NEXT_PUBLIC_ prefix precisely so Next.js can never inline it into a client
# bundle. Never add that prefix. Never import src/lib/supabase/admin.ts from a
# client component.
#
# Supabase dashboard: Project Settings -> API -> secret key
SUPABASE_SECRET_KEY=
